<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_intercompany" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.intercompany</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='warehouse_setting_container']" position="after">
                <block title="Inter Company Transfer Configuration" name="inter_company_transfer_settings">
                    <setting id="intercompany_apply_setting" help="Apply intercompany transaction on sale, purchase or both.">
                        <field name="intercompany_apply_type"/>
                    </setting>
                    <setting id="intercompany_warehouse_setting" help="Default intercompany warehouse for this company.">
                        <field name="intercompany_warehouse_id"/>
                    </setting>
                    <setting id="link_intercompany_document_setting" help="Link related documents (SO, PO, Picking, Invoices) to intercompany transfer.">
                        <field name="link_intercompany_document"/>
                    </setting>
                    <setting id="auto_validate_picking_setting" help="Automatically validate delivery orders and receipts generated from intercompany transfer.">
                        <field name="auto_validate_picking"/>
                    </setting>
                    <setting id="create_invoice_bill_setting" help="Automatically generate customer invoices and vendor bills.">
                        <field name="create_invoice_bill"/>
                    </setting>
                    <setting id="validate_invoice_bill_setting" help="Automatically validate customer invoices and vendor bills." invisible="not create_invoice_bill">
                        <field name="validate_invoice_bill"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
