<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_inherit_intercompany" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.intercompany</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_intercompany_transfer" type="object" class="oe_stat_button" icon="fa-random" invisible="intercompany_transfer_count == 0">
                    <field name="intercompany_transfer_count" widget="statinfo" string="Inter Company"/>
                </button>
            </xpath>
            <xpath expr="//group[@name='other_info']" position="inside">
                <field name="intercompany_transfer_id" readonly="1" invisible="not intercompany_transfer_id"/>
            </xpath>
        </field>
    </record>
</odoo>
