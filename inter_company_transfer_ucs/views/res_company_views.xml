<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_intercompany" model="ir.ui.view">
        <field name="name">res.company.form.inherit.intercompany</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Inter Company Configuration" name="intercompany_config">
                    <group>
                        <group string="Transaction Rules">
                            <field name="intercompany_apply_type"/>
                            <field name="intercompany_warehouse_id"/>
                            <field name="link_intercompany_document"/>
                        </group>
                        <group string="Automation Settings">
                            <field name="auto_validate_picking"/>
                            <field name="create_invoice_bill"/>
                            <field name="validate_invoice_bill" invisible="not create_invoice_bill"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
