<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_intercompany" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.intercompany</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_intercompany_transfer" type="object" class="oe_stat_button" icon="fa-random" invisible="intercompany_transfer_count == 0">
                    <field name="intercompany_transfer_count" widget="statinfo" string="Inter Company"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='origin']" position="after">
                <field name="intercompany_transfer_id" readonly="1" invisible="not intercompany_transfer_id"/>
            </xpath>
        </field>
    </record>
</odoo>
