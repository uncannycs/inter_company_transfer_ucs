<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.module.category" id="module_category_inter_company">
        <field name="name">Inter Company Transfer</field>
        <field name="description">User access level for Inter Company Transfer Operations</field>
        <field name="sequence">25</field>
    </record>

    <record model="res.groups.privilege" id="res_groups_privilege_inter_company">
        <field name="name">Inter Company Transfer</field>
        <field name="sequence">25</field>
        <field name="category_id" ref="module_category_inter_company"/>
    </record>

    <record id="group_inter_company_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_inter_company"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_inter_company_manager" model="res.groups">
        <field name="name">InterCompany Transaction Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_inter_company"/>
        <field name="implied_ids" eval="[(4, ref('group_inter_company_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Multi-Company Rules -->
    <record id="inter_company_transfer_rule" model="ir.rule">
        <field name="name">Inter Company Transfer Multi-Company Rule</field>
        <field name="model_id" ref="model_inter_company_transfer"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('from_company_id', 'in', company_ids), ('to_company_id', 'in', company_ids)]</field>
    </record>

    <record id="return_inter_company_transfer_rule" model="ir.rule">
        <field name="name">Return Inter Company Transfer Multi-Company Rule</field>
        <field name="model_id" ref="model_return_inter_company_transfer"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('from_company_id', 'in', company_ids), ('to_company_id', 'in', company_ids)]</field>
    </record>
</odoo>
